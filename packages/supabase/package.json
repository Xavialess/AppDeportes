{
  "name": "@appdeportes/supabase",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "db:types": "supabase gen types typescript --local 2>/dev/null > src/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.0"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "supabase": "^1.170.0",
    "typescript": "^5.4.0"
  }
}
